<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config — วางไว้ที่ root โปรเจค (ตำแหน่งเดียวกับ app.py, wsgi_iis.py)
  ก่อนใช้งาน ต้องแก้ 2 จุดที่มี %...% ให้เป็น path จริงบนเครื่อง server:

    1. processPath  -> path เต็มไปยัง python.exe ของ venv ที่ลง requirements.txt ไว้บน server
                        เช่น C:\inetpub\wwwroot\ITA_LINks\venv\Scripts\python.exe
    2. arguments    -> path เต็มไปยัง wsgi_iis.py
                        เช่น C:\inetpub\wwwroot\ITA_LINks\wsgi_iis.py

  Prerequisite บน server (ทำครั้งเดียว):
    - ลง IIS module "httpPlatformHandler" (ผ่าน Web Platform Installer หรือดาวน์โหลด .msi จาก Microsoft)
    - สร้าง venv บน server แล้ว pip install -r requirements.txt ในนั้น
    - ตั้งค่า Site/Application ใน IIS Manager ให้ Physical Path ชี้มาที่โฟลเดอร์นี้
    - .env ต้องอยู่ในโฟลเดอร์นี้ด้วย (ห้าม commit ขึ้น git) — ตั้ง SESSION_COOKIE_SECURE=true
      ถ้า site รันผ่าน HTTPS จริงแล้ว
    - App Pool identity ต้องมีสิทธิ์ read/execute โฟลเดอร์นี้ (และ write ถ้าเปิด stdoutLogEnabled)
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="%PATH_TO_VENV%\Scripts\python.exe"
                   arguments="%PATH_TO_PROJECT%\wsgi_iis.py"
                   stdoutLogEnabled="true"
                   stdoutLogFile=".\logs\stdout"
                   startupTimeLimit="60"
                   startupRetryCount="3">
      <environmentVariables>
        <!-- ปรับ/เพิ่ม env var เฉพาะที่จำเป็นตอนรันบน IIS ได้ที่นี่ ถ้าไม่อยากพึ่ง .env ล้วน -->
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>